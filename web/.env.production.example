# Dados persistentes no host. Docker prune não remove estes diretórios.
POSTGRES_DATA_DIR="/home/ubuntu/perfectutilitares-data/postgres"
PDF_DATA_DIR="/home/ubuntu/perfectutilitares-data/pdf-jobs"
UNIMED_TEMPLATE_DIR="/home/ubuntu/perfectutilitares-config/unimed/templates"
UNIMED_ACCESS_ENV_FILE="/home/ubuntu/perfectutilitares-config/unimed/access.env"

# Identidade do usuário não-root usado pelos contêineres.
APP_UID="1001"
APP_GID="1001"
POSTGRES_UID="999"
POSTGRES_GID="999"

# Preencher no servidor. Nunca versionar valores reais.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="troque-no-servidor"
POSTGRES_DB="perfectutilitares"
AUTH_SECRET="troque-no-servidor"
ADMIN_EMAIL="troque-no-servidor"
ADMIN_PASSWORD="troque-no-servidor"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Sistema Web <troque-no-servidor>"

APP_PORT="3002"
APP_BIND_ADDRESS="127.0.0.1"
APP_URL="https://troque-no-servidor"
AUTH_URL="https://troque-no-servidor"
NEXTAUTH_URL="https://troque-no-servidor"
APP_TIME_ZONE="America/Sao_Paulo"
