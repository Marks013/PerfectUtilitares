#!/bin/sh
set -eu

: "${DATABASE_URL:?DATABASE_URL ausente}"
heartbeat=${PDF_WORKER_HEARTBEAT_PATH:-/tmp/perfect-pdf-worker-heartbeat}
max_age=${PDF_WORKER_HEARTBEAT_MAX_AGE_SECONDS:-90}

[ -f "$heartbeat" ]
age=$(( $(date +%s) - $(stat -c %Y "$heartbeat") ))
[ "$age" -ge 0 ]
[ "$age" -le "$max_age" ]

for dependency in node libreoffice gs qpdf ocrmypdf tesseract python3 jbig2 pdfinfo pdftoppm; do
  command -v "$dependency" >/dev/null 2>&1
done

languages=$(tesseract --list-langs 2>/dev/null)
for language in eng por; do
  printf '%s\n' "$languages" | grep -qx "$language"
done

node --input-type=module -e '
  import pg from "pg";
  const url = new URL(process.env.DATABASE_URL);
  url.searchParams.delete("schema");
  const client = new pg.Client({
    connectionString: url.toString(),
    connectionTimeoutMillis: 5000,
  });
  try {
    await client.connect();
    const result = await client.query("SELECT 1 AS ok");
    if (result.rows[0]?.ok !== 1) process.exitCode = 1;
  } finally {
    await client.end().catch(() => {});
  }
'
