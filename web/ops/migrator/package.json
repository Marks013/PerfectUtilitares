{
  "name": "perfect-utilitares-migrator-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "prisma:seed": "tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy && npm run prisma:seed"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <13"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "tsx": "4.23.13"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "mysql2": "3.22.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@prisma/client@7.10.0": true
  }
