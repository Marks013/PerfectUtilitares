{
  "name": "perfect-utilitares-migrator-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "prisma:seed": "tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy && npm run prisma:seed"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <13"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "pg": "8.23.0",
    "prisma": "7.9.1",
    "tsx": "4.23.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true
  }
}
