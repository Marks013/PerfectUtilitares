#!/bin/sh
set -eu

REPOSITORY=${REPOSITORY:-/home/ubuntu/PerfectUtilitares/web}
BACKUP_ROOT=${BACKUP_ROOT:-/home/ubuntu/perfectutilitares-backups}
BACKUP_KEEP_COUNT=${BACKUP_KEEP_COUNT:-14}
BACKUP_RCLONE_REMOTE=${BACKUP_RCLONE_REMOTE:-}
LOCK_FILE=${BACKUP_LOCK_FILE:-/run/lock/perfectutilitares-backup.lock}

case "$BACKUP_KEEP_COUNT" in
  ''|*[!0-9]*) echo "BACKUP_KEEP_COUNT invalido" >&2; exit 2 ;;
esac
[ "$BACKUP_KEEP_COUNT" -ge 2 ] || { echo "Mantenha ao menos dois backups" >&2; exit 2; }
[ -d "$REPOSITORY" ] || { echo "Repositorio inexistente: $REPOSITORY" >&2; exit 1; }

BACKUP_ROOT=$(realpath -m -- "$BACKUP_ROOT")
case "$BACKUP_ROOT" in
  /|/home|/home/ubuntu) echo "BACKUP_ROOT amplo ou inseguro" >&2; exit 2 ;;
  /*) ;;
  *) echo "BACKUP_ROOT deve ser absoluto" >&2; exit 2 ;;
esac

mkdir -p -- "$BACKUP_ROOT"
chmod 0700 "$BACKUP_ROOT"
exec 9>"$LOCK_FILE"
flock -n 9 || exit 0

backup_id=$(date -u +%Y%m%dT%H%M%SZ)
partial="$BACKUP_ROOT/.partial-$backup_id-$$"
final="$BACKUP_ROOT/$backup_id"
mkdir -m 0700 "$partial"
cleanup() { rm -rf -- "$partial"; }
trap cleanup EXIT HUP INT TERM

cd "$REPOSITORY"
docker compose exec -T db sh -c 'PGPASSWORD="$POSTGRES_PASSWORD" exec pg_dump --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --format=custom --compress=9 --no-owner --no-privileges' > "$partial/database.dump"
docker compose exec -T db sh -c 'exec pg_restore --list' < "$partial/database.dump" >/dev/null

paths_file="$partial/host-files.list"
for source in \
  /home/ubuntu/perfectutilitares-config \
  /home/ubuntu/PerfectUtilitares/storage/unimed-templates \
  /home/ubuntu/PerfectUtilitares/web/.env
do
  [ -e "$source" ] && printf '%s\n' "${source#/}" >> "$paths_file"
done

if [ -s "$paths_file" ]; then
  tar -C / -czf "$partial/host-files.tar.gz" -T "$paths_file"
fi
rm -f -- "$paths_file"

printf '%s\n' \
  "created_utc=$backup_id" \
  "repository=$REPOSITORY" \
  "database_format=postgres-custom" > "$partial/metadata.txt"
(
  cd "$partial"
  sha256sum database.dump metadata.txt > SHA256SUMS
  [ ! -f host-files.tar.gz ] || sha256sum host-files.tar.gz >> SHA256SUMS
)

mv -- "$partial" "$final"
trap - EXIT HUP INT TERM

find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -name '20*' -printf '%f\n' |
  sort -r |
  awk -v keep="$BACKUP_KEEP_COUNT" 'NR > keep { print }' |
  while IFS= read -r old_name; do
    case "$old_name" in
      20[0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z)
        old_path=$(realpath -m -- "$BACKUP_ROOT/$old_name")
        [ "$(dirname -- "$old_path")" = "$BACKUP_ROOT" ] && rm -rf -- "$old_path"
        ;;
    esac
  done

if [ -n "$BACKUP_RCLONE_REMOTE" ]; then
  command -v rclone >/dev/null 2>&1 || { echo "rclone configurado, mas nao instalado" >&2; exit 1; }
  remote_path="${BACKUP_RCLONE_REMOTE%/}/$backup_id"
  rclone copy "$final" "$remote_path" --checksum
  rclone check "$final" "$remote_path" --one-way
fi

logger -t perfectutilitares-backup "backup concluido: $final"
printf '%s\n' "$final"
