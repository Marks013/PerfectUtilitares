# Defaults from perfectutilitares-backup. Daily snapshots for 7 days,
# then the latest snapshot of each ISO week until the 30-day limit.
# These values document existing runtime defaults. This file is not applied
# automatically to /etc/perfectutilitares-backup.conf on any server.
BACKUP_ROOT=/home/ubuntu/perfectutilitares-backups
BACKUP_DAILY_KEEP_DAYS=7
BACKUP_MAX_AGE_DAYS=30

# Optional. Configure the rclone remote first; credentials stay outside
# this file. A remote copy is checked after uploading.
BACKUP_RCLONE_REMOTE=
