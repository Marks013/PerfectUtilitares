DISK_WARN_PERCENT=78
DISK_CLEANUP_PERCENT=80
DISK_RESUME_PERCENT=80
DISK_BLOCK_PERCENT=85
DISK_CRITICAL_PERCENT=90
DISK_BLOCK_FREE_GIB=30
DISK_RESUME_FREE_GIB=35
DISK_CRITICAL_FREE_GIB=15
INODE_WARN_PERCENT=70
MEMORY_WARN_MIB=4096
MEMORY_BLOCK_MIB=3072
MEMORY_CRITICAL_MIB=1536
MEMORY_RESUME_MIB=4096
# Admission is immediate; only notification delivery waits for confirmation.
ALERT_WARNING_SECONDS=900
ALERT_BLOCKED_SECONDS=240
ALERT_RECOVERY_SECONDS=1800
ALERT_MIN_INTERVAL_SECONDS=14400
ALERT_REMINDER_SECONDS=86400
ALERT_CRITICAL_REMINDER_SECONDS=21600
ALERT_RETRY_SECONDS=600
ALERT_MAX_SAMPLE_GAP_SECONDS=600
ALERT_QUIET_START_HOUR=18
ALERT_QUIET_END_HOUR=8
ALERT_TIMEZONE=America/Sao_Paulo
ALERT_CONFIG=/etc/reboot-required-email-notifier/config
