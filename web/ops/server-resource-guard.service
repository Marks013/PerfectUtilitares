[Unit]
Description=Monitor host capacity and gate heavy application work
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/server-resource-guard
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/server-resource-guard
LockPersonality=true
MemoryDenyWriteExecute=true
