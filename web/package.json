{
  "name": "perfect-utilitares-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "predev": "npm run sync:pdfjs",
    "setup:env": "node scripts/ensure-env.mjs",
    "env:set": "node scripts/set-env-value.mjs",
    "setup:unimed-access": "node scripts/configure-unimed-access.mjs",
    "sync:mediapipe": "npm run sync:mediapipe:check",
    "sync:mediapipe:check": "node scripts/sync-mediapipe.mjs check",
    "sync:mediapipe:update": "node scripts/sync-mediapipe.mjs update",
    "sync:pdfjs": "node scripts/sync-pdfjs-worker.mjs",
    "sync:check": "npm run sync:mediapipe:check",
    "sync:update": "npm run sync:mediapipe:update && npm run sync:pdfjs",
    "unimed:build-rn561-template": "node scripts/unimed/build-rn561-template.mjs",
    "smoke:unimed-access": "node scripts/unimed/smoke-public-access.mjs",
    "smoke:unimed-documents": "node scripts/unimed/smoke-documents.mjs",
    "verify:unimed-rendered-document": "node scripts/unimed/verify-rendered-document.mjs",
    "smoke:pdf-queue": "node scripts/smoke-pdf-queue.mjs",
    "validate:unimed-real-import": "tsx scripts/unimed/validate-real-import.ts",
    "clean:optional-wasm": "node scripts/clean-optional-wasm.mjs",
    "cleanup:artifacts": "node scripts/cleanup-artifacts.mjs",
    "cleanup:deploy": "npm run cleanup:artifacts && node scripts/cleanup-deploy.mjs",
    "prebuild": "npm run setup:env && npm run sync:check && npm run sync:pdfjs && npm run prisma:generate",
    "build": "next build --turbopack",
    "build:pdf-worker": "esbuild src/workers/pdf-worker.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/pdf-worker.mjs",
    "postbuild": "npm run clean:optional-wasm && npm run cleanup:artifacts",
    "start": "node server.js",
    "worker:pdf": "node dist/pdf-worker.mjs",
    "test": "vitest run",
    "quality:dead-code": "knip",
    "quality": "npm run prisma:validate && npm run typecheck && npm test && npm run quality:dead-code",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy && npm run prisma:seed",
    "build:deploy": "npm run build && npm run db:deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.2.2",
    "@mediapipe/face_detection": "0.4.1646425229",
    "@napi-rs/canvas": "1.0.3",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@sentry/nextjs": "10.69.0",
    "@sentry/node": "10.69.0",
    "@sentry/profiling-node": "10.69.0",
    "@tanstack/react-query": "5.100.9",
    "@types/archiver": "8.0.0",
    "@types/pdfkit": "^0.17.6",
    "archiver": "8.0.0",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "csv-parse": "6.2.1",
    "dotenv": "17.4.2",
    "fflate": "0.8.2",
    "jszip": "^3.10.1",
    "lucide-react": "1.14.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "pdfkit": "^0.18.0",
    "pg-boss": "12.26.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-dropzone": "19.1.1",
    "react-easy-crop": "^5.5.7--canary.642.b63bd1a.0",
    "react-hook-form": "7.75.0",
    "read-excel-file": "9.0.9",
    "resend": "^6.12.3",
    "sharp": "0.35.3",
    "tailwind-merge": "3.5.0-dev.c719d45eb836accd1fd4b04c9d2e65e8f342a025",
    "zod": "4.5.0-canary.20260504T180558"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "knip": "6.29.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0-beta.7"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "$sharp",
    "esbuild": "0.28.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@sentry/cli@2.58.6": true,
    "@sentry/node-cpu-profiler@2.4.2": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true
  }
}
