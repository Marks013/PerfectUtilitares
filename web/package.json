{
  "name": "perfect-utilitares-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "predev": "npm run sync:pdfjs && npm run build:ferias-worker",
    "setup:env": "node scripts/ensure-env.mjs",
    "env:set": "node scripts/set-env-value.mjs",
    "admin:rotate-password": "tsx scripts/rotate-admin-password.ts",
    "setup:unimed-access": "node scripts/configure-unimed-access.mjs",
    "setup:presence-webhook": "node scripts/configure-presence-webhook.mjs",
    "sync:mediapipe": "npm run sync:mediapipe:check",
    "sync:mediapipe:check": "node scripts/sync-mediapipe.mjs check",
    "sync:mediapipe:update": "node scripts/sync-mediapipe.mjs update",
    "sync:pdfjs": "node scripts/sync-pdfjs-worker.mjs",
    "sync:check": "npm run sync:mediapipe:check",
    "sync:update": "npm run sync:mediapipe:update && npm run sync:pdfjs",
    "unimed:build-rn561-template": "node scripts/unimed/build-rn561-template.mjs",
    "smoke:unimed-access": "node scripts/unimed/smoke-public-access.mjs",
    "smoke:unimed-documents": "tsx scripts/unimed/smoke-documents.mjs",
    "verify:unimed-rendered-document": "node scripts/unimed/verify-rendered-document.mjs",
    "smoke:pdf-queue": "node scripts/smoke-pdf-queue.mjs",
    "validate:unimed-real-import": "tsx scripts/unimed/validate-real-import.ts",
    "clean:optional-wasm": "node scripts/clean-optional-wasm.mjs",
    "cleanup:artifacts": "node scripts/cleanup-artifacts.mjs",
    "cleanup:deploy": "npm run cleanup:artifacts && node scripts/cleanup-deploy.mjs",
    "prebuild": "npm run setup:env && npm run sync:check && npm run sync:pdfjs && npm run prisma:generate && npm run build:ferias-worker",
    "build": "next build",
    "build:ferias-worker": "node scripts/build-ferias-worker.mjs",
    "build:pdf-worker": "esbuild src/workers/pdf-worker.ts --bundle --platform=node --format=esm --target=node24 --packages=external --alias:@sentry/nextjs=@sentry/node --outfile=dist/pdf-worker.mjs",
    "docker:build": "node scripts/docker-production.mjs build",
    "docker:deploy": "node scripts/docker-production.mjs deploy",
    "security:containers": "node scripts/audit-container-images.mjs",
    "postbuild": "npm run clean:optional-wasm && npm run cleanup:artifacts",
    "start": "node server.js",
    "worker:pdf": "node dist/pdf-worker.mjs",
    "test": "vitest run",
    "test:ops": "node --test ops/server-resource-guard.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "node scripts/run-isolated-e2e.mjs",
    "test:e2e:smoke": "playwright test e2e/auth.spec.ts",
    "quality:dead-code": "knip",
    "quality": "npm run prisma:validate && npm run typecheck && npm run lint && npm run test:ops && npm run test:coverage && npm run quality:dead-code && npm run quality:module-size && npm run quality:route-tests && npm run test:e2e:isolated",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy && npm run prisma:seed",
    "build:deploy": "npm run build && npm run db:deploy",
    "prisma:smoke": "tsx scripts/prisma7-smoke.ts",
    "presence:concurrency-smoke": "tsx scripts/presence-concurrency-smoke.ts",
    "lint": "biome lint src --diagnostic-level=warn --error-on-warnings --max-diagnostics=100",
    "lint:strict": "biome lint src --error-on-warnings --max-diagnostics=200",
    "test:coverage": "vitest run --coverage",
    "quality:module-size": "node scripts/check-module-size.mjs",
    "quality:route-tests": "node scripts/check-route-test-coverage.mjs",
    "lint:report": "biome lint src --diagnostic-level=warn --max-diagnostics=200 --reporter=summary"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.9.1",
    "@mediapipe/face_detection": "0.4.1646425229",
    "@napi-rs/canvas": "1.0.8",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@sentry/nextjs": "10.73.0",
    "@sentry/node": "10.73.0",
    "@sentry/profiling-node": "10.73.0",
    "@tanstack/react-query": "5.102.8",
    "@xmldom/xmldom": "0.9.12",
    "archiver": "8.0.0",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "csv-parse": "7.0.2",
    "dotenv": "17.4.2",
    "fflate": "0.8.3",
    "jszip": "^3.10.1",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "9.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "pg-boss": "12.29.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "20.1.1",
    "react-easy-crop": "6.2.3",
    "react-hook-form": "7.87.0",
    "read-excel-file": "9.3.10",
    "resend": "6.25.0",
    "sharp": "0.35.4",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/archiver": "8.0.0",
    "@types/node": "26.4.1",
    "@types/nodemailer": "8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "knip": "6.34.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.1.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "postcss": "8.5.25",
    "sharp": "$sharp",
    "esbuild": "0.28.2",
    "mysql2": "3.22.0",
    "vite": {
      "lightningcss": "1.32.0"
    },
    "nodemailer": "$nodemailer"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@sentry/node-cpu-profiler@2.4.3": true,
    "@prisma/client@7.10.0": true
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <13"
  }
}
