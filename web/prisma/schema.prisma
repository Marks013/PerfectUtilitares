generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CodigoOrigem {
  XLSX
  CSV
  JSON
  MANUAL
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum UserStatus {
  ACTIVE
  BLOCKED
  BANNED
}

enum UsageModule {
  JORNADA
  FOTOS
  PDF
}

enum PdfJobStatus {
  DRAFT
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PdfOperation {
  COMPRESS
  MERGE
  SPLIT
  ROTATE
  DELETE_PAGES
  EXTRACT_PAGES
  ORGANIZE
  EDIT
  ANNOTATE
  CROP
  PDF_TO_JPG
  JPG_TO_PDF
  PDF_TO_WORD
  PDF_TO_EXCEL
  WORD_TO_PDF
  EXCEL_TO_PDF
}

enum PdfArtifactKind {
  INPUT
  OUTPUT
  PREVIEW
}

model CodigoJornada {
  id                  String       @id @default(cuid())
  codigo              String
  horariosOriginal    String
  horariosNormalizado String       @unique
  origem              CodigoOrigem @default(MANUAL)
  linha               Int?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model User {
  id                String              @id @default(cuid())
  tenantId          String?
  tenant            Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  email             String              @unique
  name              String
  passwordHash      String
  role              UserRole            @default(OPERATOR)
  status            UserStatus          @default(ACTIVE)
  validations       JornadaValidation[]
  jornadaExceptions JornadaException[]
  pdfJobs           PdfJob[]
  usageDaily        UserUsageDaily[]
  auditLogs         AuditLog[]
  invitations       UserInvitation[]    @relation("InvitedBy")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([tenantId])
}

model Tenant {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  users       User[]
  invitations UserInvitation[]
  pdfJobs     PdfJob[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserInvitation {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  email       String
  name        String
  role        UserRole  @default(OPERATOR)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([email])
  @@index([expiresAt])
}

model PdfJob {
  id               String        @id @default(cuid())
  tenantId         String?
  tenant           Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerSessionHash String?
  principalKey     String
  operation        PdfOperation
  status           PdfJobStatus  @default(DRAFT)
  progress         Int           @default(0)
  options          Json?
  errorCode        String?
  errorMessage     String?
  inputBytes       BigInt        @default(0)
  outputBytes      BigInt        @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  expiresAt        DateTime
  artifacts        PdfArtifact[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([expiresAt])
  @@index([ownerSessionHash, status, expiresAt])
  @@index([principalKey, status, expiresAt])
  @@index([userId, status, expiresAt])
}

model PdfArtifact {
  id           String          @id @default(cuid())
  jobId        String
  job          PdfJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind         PdfArtifactKind
  storageKey   String          @unique
  originalName String
  mimeType     String
  sizeBytes    BigInt
  sha256       String
  pageCount    Int?
  createdAt    DateTime        @default(now())

  @@index([jobId, kind])
}

model ApiRateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model UserUsageDaily {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime    @db.Date
  module      UsageModule
  operation   String
  count       Int         @default(0)
  inputBytes  BigInt      @default(0)
  outputBytes BigInt      @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, date, module, operation])
  @@index([date])
  @@index([userId, date])
}

model JornadaRule {
  id             String   @id @default(cuid())
  nome           String   @unique
  duracaoMinutos Int
  horasSemanais  Int
  horasMensais   Int
  intervaloMin   Int
  intervaloMax   Int
  diasValidos    String[]
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model JornadaException {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome                String?
  horariosOriginal    String
  horariosNormalizado String
  sabadoOriginal      String?
  sabadoNormalizado   String?
  active              Boolean  @default(true)
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([active])
  @@index([horariosNormalizado])
  @@index([sabadoNormalizado])
}

model JornadaValidation {
  id                  String   @id @default(cuid())
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  horariosOriginal    String
  horariosNormalizado String
  valido              Boolean
  mensagem            String
  duracaoCalculada    String?
  tipoDia             String
  codigo              String?
  horasSemanais       Int?
  horasMensais        Int?
  intervalo           String?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([valido])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}
