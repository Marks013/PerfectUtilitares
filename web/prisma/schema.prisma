generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum CodigoOrigem {
  XLSX
  CSV
  JSON
  MANUAL
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum UserStatus {
  ACTIVE
  BLOCKED
  BANNED
}

enum UsageModule {
  JORNADA
  FOTOS
  PDF
}

enum PdfJobStatus {
  DRAFT
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PdfOperation {
  COMPRESS
  MERGE
  SPLIT
  ROTATE
  DELETE_PAGES
  EXTRACT_PAGES
  ORGANIZE
  EDIT
  ANNOTATE
  CROP
  PDF_TO_JPG
  JPG_TO_PDF
  PDF_TO_WORD
  PDF_TO_EXCEL
  WORD_TO_PDF
  EXCEL_TO_PDF
}

enum PdfArtifactKind {
  INPUT
  OUTPUT
  PREVIEW
}

enum UnimedAccessLevel {
  ADMIN
  MANAGER
  OPERATOR
}

enum UnimedCompetencyStatus {
  DRAFT
  VALIDATING
  READY
  ACTIVE
  PREVIOUS
  REJECTED
}

enum UnimedImportStatus {
  STAGED
  VALIDATING
  VALID
  INVALID
  PUBLISHED
  DISCARDED
}

enum UnimedImportSource {
  BENEFICIARIES
  INVOICES
  ADDRESSES
  PAYROLL_LOANS
}

enum UnimedBeneficiaryCategory {
  HOLDER
  DEPENDENT
}

enum UnimedBillingClosure {
  OPEN
  AUTOMATIC_DAY_25
}

enum UnimedDocumentKind {
  RN561
  INACTIVE_TERM
  NONE
}

enum PresenceEventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum PresenceRsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum PresenceDeliveryStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  DELAYED
  BOUNCED
  COMPLAINED
  SUPPRESSED
  FAILED
}

enum PresenceDeliveryKind {
  INVITATION
  REMINDER
}

model CodigoJornada {
  id                  String       @id @default(cuid())
  codigo              String
  horariosOriginal    String
  horariosNormalizado String       @unique
  origem              CodigoOrigem @default(MANUAL)
  linha               Int?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model User {
  id                     String              @id @default(cuid())
  tenantId               String?
  tenant                 Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  email                  String              @unique
  name                   String
  passwordHash           String
  role                   UserRole            @default(OPERATOR)
  status                 UserStatus          @default(ACTIVE)
  validations            JornadaValidation[]
  jornadaExceptions      JornadaException[]
  pdfJobs                PdfJob[]
  usageDaily             UserUsageDaily[]
  auditLogs              AuditLog[]
  invitations            UserInvitation[]    @relation("InvitedBy")
  unimedAccess           UnimedUserAccess?
  unimedRequestedImports UnimedImportBatch[] @relation("UnimedImportRequestedBy")
  unimedPublishedImports UnimedImportBatch[] @relation("UnimedImportPublishedBy")
  presenceEventsCreated  PresenceEvent[]     @relation("PresenceEventsCreatedBy")
  presenceActivities     PresenceActivity[]  @relation("PresenceActivitiesActor")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([tenantId])
}

model Tenant {
  id                      String                         @id @default(cuid())
  name                    String
  slug                    String                         @unique
  users                   User[]
  invitations             UserInvitation[]
  pdfJobs                 PdfJob[]
  unimedAccesses          UnimedUserAccess[]
  unimedModuleSessions    UnimedModuleSession[]
  unimedExcelDevices      UnimedExcelDevice[]
  unimedCompetencies      UnimedCompetency[]
  unimedImportBatches     UnimedImportBatch[]
  unimedImportSnapshots   UnimedImportSnapshot[]
  unimedBranches          UnimedBranch[]
  unimedBeneficiaries     UnimedBeneficiary[]
  unimedPayrollLoans      UnimedPayrollLoan[]
  unimedAgeBrackets       UnimedAgeBracket[]
  unimedPlanPrices        UnimedPlanPriceVersion[]
  unimedAddonPrices       UnimedAddonPriceVersion[]
  unimedBillingSettings   UnimedBillingSetting[]
  unimedExclusionReasons  UnimedExclusionReason[]
  unimedCalculationRules  UnimedCalculationRuleVersion[]
  unimedEmailSetting      UnimedEmailSetting?
  unimedEmailSequences    UnimedEmailDailySequence[]
  unimedDocumentTemplates UnimedDocumentTemplate[]
  unimedEmailEvents       UnimedEmailEvent[]
  presenceEvents          PresenceEvent[]
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
}

model UserInvitation {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  email       String
  name        String
  role        UserRole  @default(OPERATOR)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([invitedById])
  @@index([email])
  @@index([expiresAt])
}

model PresenceEvent {
  id                   String                 @id @default(cuid())
  tenantId             String
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById          String?
  createdBy            User?                  @relation("PresenceEventsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  eventSlug            String                 @unique
  title                String
  description          String?
  startsAt             DateTime
  venueName            String?
  venueAddress         String?
  confirmationDeadline DateTime
  timeZone             String                 @default("America/Sao_Paulo")
  status               PresenceEventStatus    @default(DRAFT)
  theme                Json?
  publicRevision       Int                    @default(0)
  reminderAt           DateTime?
  reminderProcessedAt  DateTime?
  retentionUntil       DateTime?
  guests               PresenceGuest[]
  giftCategories       PresenceGiftCategory[]
  gifts                PresenceGift[]
  deliveries           PresenceDelivery[]
  activities           PresenceActivity[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([tenantId, status])
  @@index([createdById])
  @@index([status, reminderAt, reminderProcessedAt])
  @@index([retentionUntil])
}

model PresenceGuest {
  id               String                    @id @default(cuid())
  eventId          String
  event            PresenceEvent             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  guestSlug        String
  rsvpStatus       PresenceRsvpStatus        @default(PENDING)
  companionLimit   Int                       @default(0)
  companionCount   Int                       @default(0)
  adultCount       Int                       @default(0)
  childCount       Int                       @default(0)
  tokenHash        String                    @unique
  accessVersion    Int                       @default(1)
  shortCodeHash    String?                   @unique
  accessExpiresAt  DateTime?
  tokenRevokedAt   DateTime?
  respondedAt      DateTime?
  sessions         PresenceGuestSession[]
  reservedGifts    PresenceGift[]            @relation("PresenceGiftReservedBy")
  giftReservations PresenceGiftReservation[]
  deliveries       PresenceDelivery[]
  activities       PresenceActivity[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([eventId, guestSlug])
  @@unique([eventId, email])
  @@index([eventId, rsvpStatus])
  @@index([accessExpiresAt])
}

model PresenceGuestSession {
  id            String        @id @default(cuid())
  guestId       String
  guest         PresenceGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  sessionHash   String        @unique
  accessVersion Int
  expiresAt     DateTime
  revokedAt     DateTime?
  lastSeenAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())

  @@index([guestId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model PresenceGiftCategory {
  id             String         @id @default(cuid())
  eventId        String
  event          PresenceEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  emoji          String         @default("🏠")
  position       Int            @default(0)
  gifts          PresenceGift[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([eventId, normalizedName])
  @@index([eventId, position])
}

model PresenceGift {
  id                String                    @id @default(cuid())
  eventId           String
  event             PresenceEvent             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId        String?
  category          PresenceGiftCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  emoji             String                    @default("🎁")
  title             String
  description       String?
  externalUrl       String?
  position          Int                       @default(0)
  active            Boolean                   @default(true)
  quantity          Int?                      @default(1)
  reservedManually  Boolean                   @default(false)
  reservedByGuestId String?
  reservedByGuest   PresenceGuest?            @relation("PresenceGiftReservedBy", fields: [reservedByGuestId], references: [id], onDelete: SetNull)
  reservedAt        DateTime?
  reservations      PresenceGiftReservation[]
  version           Int                       @default(0)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([eventId, active, position])
  @@index([categoryId, position])
  @@index([reservedByGuestId])
}

model PresenceGiftReservation {
  id         String        @id @default(cuid())
  giftId     String
  gift       PresenceGift  @relation(fields: [giftId], references: [id], onDelete: Cascade)
  guestId    String
  guest      PresenceGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reservedAt DateTime      @default(now())

  @@unique([giftId, guestId])
  @@index([giftId, reservedAt])
  @@index([guestId])
}

model PresenceDelivery {
  id                String                 @id @default(cuid())
  eventId           String
  event             PresenceEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId           String?
  guest             PresenceGuest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)
  idempotencyKey    String
  kind              PresenceDeliveryKind   @default(INVITATION)
  status            PresenceDeliveryStatus @default(PENDING)
  attemptCount      Int                    @default(0)
  nextAttemptAt     DateTime?
  lastErrorCode     String?
  providerMessageId String?
  providerStatus    String?
  providerEventAt   DateTime?
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  complainedAt      DateTime?
  webhookEvents     PresenceWebhookEvent[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([eventId, idempotencyKey])
  @@index([eventId, status, nextAttemptAt])
  @@index([guestId])
  @@index([providerMessageId])
}

model PresenceWebhookEvent {
  id                String            @id
  deliveryId        String?
  delivery          PresenceDelivery? @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  providerMessageId String
  type              String
  occurredAt        DateTime
  createdAt         DateTime          @default(now())

  @@index([deliveryId, occurredAt])
  @@index([providerMessageId])
  @@index([createdAt])
}

model PresenceActivity {
  id          String         @id @default(cuid())
  eventId     String
  event       PresenceEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId     String?
  guest       PresenceGuest? @relation(fields: [guestId], references: [id], onDelete: SetNull)
  actorUserId String?
  actorUser   User?          @relation("PresenceActivitiesActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([eventId, createdAt])
  @@index([guestId, createdAt])
  @@index([actorUserId, createdAt])
}

model PdfJob {
  id               String        @id @default(cuid())
  tenantId         String?
  tenant           Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerSessionHash String?
  principalKey     String        @default(dbgenerated("('legacy:rollback:'::text || (gen_random_uuid())::text)"))
  operation        PdfOperation
  status           PdfJobStatus  @default(DRAFT)
  progress         Int           @default(0)
  options          Json?
  errorCode        String?
  errorMessage     String?
  inputBytes       BigInt        @default(0)
  outputBytes      BigInt        @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  expiresAt        DateTime
  artifacts        PdfArtifact[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tenantId])
  @@index([expiresAt])
  @@index([ownerSessionHash, status, expiresAt])
  @@index([principalKey, status, expiresAt])
  @@index([userId, status, expiresAt])
}

model PdfArtifact {
  id           String          @id @default(cuid())
  jobId        String
  job          PdfJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind         PdfArtifactKind
  storageKey   String          @unique
  originalName String
  mimeType     String
  sizeBytes    BigInt
  sha256       String
  pageCount    Int?
  createdAt    DateTime        @default(now())

  @@index([jobId, kind])
}

model ApiRateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model UserUsageDaily {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime    @db.Date
  module      UsageModule
  operation   String
  count       Int         @default(0)
  inputBytes  BigInt      @default(0)
  outputBytes BigInt      @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, date, module, operation])
  @@index([date])
  @@index([userId, date])
}

model JornadaRule {
  id                   String   @id @default(cuid())
  nome                 String   @unique
  duracaoMinutos       Int
  horasSemanais        Int
  horasMensais         Int
  intervaloMin         Int
  intervaloMax         Int
  limitePeriodoMinutos Int      @default(240)
  diasValidos          String[]
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model JornadaException {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome                String?
  horariosOriginal    String
  horariosNormalizado String
  sabadoOriginal      String?
  sabadoNormalizado   String?
  active              Boolean  @default(true)
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([active])
  @@index([horariosNormalizado])
  @@index([sabadoNormalizado])
}

model JornadaValidation {
  id                  String   @id @default(cuid())
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  horariosOriginal    String
  horariosNormalizado String
  valido              Boolean
  mensagem            String
  duracaoCalculada    String?
  tipoDia             String
  codigo              String?
  horasSemanais       Int?
  horasMensais        Int?
  intervalo           String?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([valido])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model SeoWebVital {
  id             String   @id @default(cuid())
  path           String
  metric         String
  value          Float
  rating         String
  navigationType String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([path, metric, createdAt])
}

model UnimedUserAccess {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String            @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     UnimedAccessLevel @default(OPERATOR)
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([tenantId, active])
}

model UnimedModuleSession {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokenHash    String             @unique
  level        UnimedAccessLevel
  operatorName String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime           @default(now())
  emailEvents  UnimedEmailEvent[]

  @@index([tenantId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model UnimedExcelDevice {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  tokenPrefix String
  label       String
  createdBy   String
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, revokedAt, expiresAt])
}

model UnimedCompetency {
  id              String                 @id @default(cuid())
  tenantId        String
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year            Int
  month           Int
  status          UnimedCompetencyStatus @default(DRAFT)
  activatedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  importBatches   UnimedImportBatch[]
  importSnapshots UnimedImportSnapshot[]
  beneficiaries   UnimedBeneficiary[]
  invoiceItems    UnimedInvoiceItem[]
  payrollLoans    UnimedPayrollLoan[]

  @@unique([tenantId, year, month])
  @@index([tenantId, status])
  @@index([tenantId, activatedAt])
}

model UnimedImportBatch {
  id                String                     @id @default(cuid())
  tenantId          String
  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competencyId      String
  competency        UnimedCompetency           @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  requestedById     String?
  requestedBy       User?                      @relation("UnimedImportRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  publishedById     String?
  publishedBy       User?                      @relation("UnimedImportPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  idempotencyKey    String
  status            UnimedImportStatus         @default(STAGED)
  sourceCount       Int                        @default(0)
  rowCount          Int                        @default(0)
  rejectedCount     Int                        @default(0)
  warningCount      Int                        @default(0)
  validationSummary Json?
  finishedAt        DateTime?
  publishedAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  sourceResults     UnimedImportSourceResult[]
  payrollLoans      UnimedPayrollLoan[]

  @@unique([tenantId, idempotencyKey])
  @@index([competencyId, status])
  @@index([requestedById, createdAt])
  @@index([publishedById])
}

model UnimedImportSourceResult {
  id            String             @id @default(cuid())
  batchId       String
  batch         UnimedImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  source        UnimedImportSource
  fileCount     Int
  rowCount      Int
  rejectedCount Int                @default(0)
  warningCount  Int                @default(0)
  checksum      String?
  summary       Json?
  createdAt     DateTime           @default(now())

  @@unique([batchId, source])
}

model UnimedImportSnapshot {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competencyId String
  competency   UnimedCompetency   @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  source       UnimedImportSource
  checksum     String
  rowCount     Int
  payload      Json
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([competencyId, source])
  @@index([tenantId, source])
}

model UnimedPayrollLoan {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competencyId      String
  competency        UnimedCompetency   @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  importBatchId     String?
  importBatch       UnimedImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  beneficiaryId     String?
  beneficiary       UnimedBeneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  sourceKey         String
  sourceRow         Int
  competence        String
  cpfNormalized     String?
  registration      String?
  employeeName      String
  contractNumber    String
  installmentAmount Decimal            @db.Decimal(14, 2)
  startCompetence   String
  endCompetence     String
  bankCode          String
  bankName          String
  totalInstallments Int?
  loanAmount        Decimal?           @db.Decimal(14, 2)
  releasedAmount    Decimal?           @db.Decimal(14, 2)
  contractStartDate DateTime?          @db.Date
  contractEndDate   DateTime?          @db.Date
  companyCnpj       String?
  matchMethod       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([competencyId, sourceKey])
  @@index([tenantId, competence, cpfNormalized])
  @@index([competencyId, registration])
  @@index([beneficiaryId])
  @@index([importBatchId])
}

model UnimedBranch {
  id                String              @id @default(cuid())
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code              String
  name              String
  companyName       String?
  cnpj              String
  addressLine       String?
  number            String?
  district          String?
  postalCode        String?
  city              String?
  state             String?
  stateRegistration String?
  phone             String?
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  beneficiaries     UnimedBeneficiary[]
  invoiceItems      UnimedInvoiceItem[]

  @@unique([tenantId, code])
  @@unique([tenantId, cnpj])
  @@index([tenantId, active])
}

model UnimedBeneficiary {
  id            String                    @id @default(cuid())
  tenantId      String
  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competencyId  String
  competency    UnimedCompetency          @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        UnimedBranch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  holderId      String?
  holder        UnimedBeneficiary?        @relation("UnimedDependents", fields: [holderId], references: [id], onDelete: SetNull)
  dependents    UnimedBeneficiary[]       @relation("UnimedDependents")
  sourceKey     String
  registration  String?
  fullName      String
  cpf           String?
  rg            String?
  birthDate     DateTime?                 @db.Date
  inclusionDate DateTime?                 @db.Date
  category      UnimedBeneficiaryCategory
  relationship  String?
  planCode      String?
  planName      String?
  accommodation String?
  companyCnpj   String?
  hasAddon      Boolean                   @default(false)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  address       UnimedAddress?
  invoiceItems  UnimedInvoiceItem[]
  payrollLoans  UnimedPayrollLoan[]

  @@unique([competencyId, sourceKey])
  @@index([tenantId, competencyId, fullName])
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "UnimedBeneficiary_fullName_trgm_idx")
  @@index([competencyId, cpf])
  @@index([competencyId, registration])
  @@index([holderId])
  @@index([branchId])
}

model UnimedAddress {
  id            String            @id @default(cuid())
  beneficiaryId String            @unique
  beneficiary   UnimedBeneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  addressLine   String?
  number        String?
  complement    String?
  district      String?
  postalCode    String?
  city          String?
  state         String?
  pis           String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model UnimedInvoiceItem {
  id              String                    @id @default(cuid())
  competencyId    String
  competency      UnimedCompetency          @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          UnimedBranch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  beneficiaryId   String?
  beneficiary     UnimedBeneficiary?        @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  sourceKey       String
  beneficiaryName String
  holderName      String?
  category        UnimedBeneficiaryCategory
  itemCode        String?
  itemDescription String
  amount          Decimal                   @db.Decimal(14, 2)
  planCode        String?
  planName        String?
  createdAt       DateTime                  @default(now())

  @@unique([competencyId, sourceKey])
  @@index([competencyId, beneficiaryName])
  @@index([competencyId, holderName])
  @@index([beneficiaryId])
  @@index([branchId])
}

model UnimedAgeBracket {
  id         String                   @id @default(cuid())
  tenantId   String
  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code       String
  label      String
  minAge     Int
  maxAge     Int?
  sortOrder  Int
  active     Boolean                  @default(true)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  planPrices UnimedPlanPriceVersion[]

  @@unique([tenantId, code])
  @@unique([tenantId, sortOrder])
  @@index([tenantId, active])
}

model UnimedPlanPriceVersion {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ageBracketId   String
  ageBracket     UnimedAgeBracket @relation(fields: [ageBracketId], references: [id], onDelete: Restrict)
  planCode       String
  companyAmount  Decimal          @db.Decimal(14, 2)
  employeeAmount Decimal          @db.Decimal(14, 2)
  validFrom      DateTime         @db.Date
  validTo        DateTime?        @db.Date
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([tenantId, ageBracketId, planCode, validFrom])
  @@index([tenantId, planCode, validFrom, validTo])
}

model UnimedAddonPriceVersion {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  label     String
  amount    Decimal   @db.Decimal(14, 2)
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, code, validFrom])
  @@index([tenantId, code, validFrom, validTo])
}

model UnimedBillingSetting {
  id         String               @id @default(cuid())
  tenantId   String
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  closure    UnimedBillingClosure
  closingDay Int?
  validFrom  DateTime             @db.Date
  validTo    DateTime?            @db.Date
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([tenantId, validFrom])
  @@index([tenantId, validFrom, validTo])
}

model UnimedExclusionReason {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code         Int
  label        String
  documentKind UnimedDocumentKind
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model UnimedCalculationRuleVersion {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  annualAdjustment Decimal   @db.Decimal(7, 4)
  difference       Decimal   @db.Decimal(7, 4)
  validFrom        DateTime  @db.Date
  validTo          DateTime? @db.Date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, validFrom])
  @@index([tenantId, validFrom, validTo])
}

model UnimedEmailSetting {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients      String[]
  subjectTemplate String
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UnimedEmailDailySequence {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, day])
  @@index([tenantId, day])
}

model UnimedEmailEvent {
  id              String               @id @default(cuid())
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleSessionId String?
  moduleSession   UnimedModuleSession? @relation(fields: [moduleSessionId], references: [id], onDelete: SetNull)
  beneficiaryId   String
  idempotencyKey  String
  status          String
  attempts        Int                  @default(1)
  operatorName    String
  recipientCount  Int?
  subjectSequence Int?
  errorCode       String?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([moduleSessionId, createdAt])
}

model UnimedDocumentTemplate {
  id         String             @id @default(cuid())
  tenantId   String
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind       UnimedDocumentKind
  version    Int
  storageKey String
  sha256     String
  active     Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([tenantId, kind, version])
  @@index([tenantId, kind, active])
}
